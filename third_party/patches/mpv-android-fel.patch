+static bool stage_fel_before_publish(struct priv *p, struct mp_frame frame)
+{
+    if (!p->android_fel || p->software_el || !p->queue ||
+        frame.type != MP_FRAME_VIDEO)
+        return true;
+    struct mp_image *image = frame.data;
+    if (image->imgfmt != IMGFMT_MEDIACODEC)
+        return true;
+    struct vo *vo = p->stream_info.dr_vo;
+    if (!vo)
+        return false;
+
+    // This is the independent BL worker, before publishing to the async queue.
+    // A queue limit cannot stop receive_frame from waiting on a Surface that
+    // the pair/core has not returned yet. Complete that handoff first instead.
+    int64_t started = mp_time_ns();
+    int result;
+    do {
+        result = vo_prepare_fel_frame(vo, image);
+        if (result == VO_NOTIMPL)
+            return true; // Existing non-staging (e.g. OpenGL) path.
+        if (result == VO_TRUE && image->android_fel_staging &&
+            mp_android_fel_staging_ready(image->android_fel_staging->data))
+        {
+            int64_t elapsed = mp_time_ns() - started;
+            p->fel_staged++;
+            p->fel_stage_ns += elapsed;
+            p->fel_stage_max_ns = MPMAX(p->fel_stage_max_ns, elapsed);
+            double now = mp_time_sec();
+            if (p->fel_staged == 1 || now - p->fel_stage_log_at >= 3.0) {
+                MP_INFO(p, "WebHTV FEL producer handoff: staged=%llu "
+                           "retries=%llu avg-us=%lld max-us=%lld pts=%.6f "
+                           "source-returned=1 before-publish=1.\n",
+                        p->fel_staged, p->fel_stage_retries,
+                        (long long)(p->fel_stage_ns / p->fel_staged / 1000),
+                        (long long)(p->fel_stage_max_ns / 1000), image->pts);
+                p->fel_stage_log_at = now;
+            }
+            return true;
+        }
+        if (result != VO_FALSE && result != VO_TRUE)
+            break;
+        p->fel_stage_retries++;
+        // VO work is asynchronous, including GPU waits. Do not wait on its
+        // dispatch lock or service decoder-reset commands with a frame live
+        // on this stack. The existing 750 ms bound also bounds this handoff.
+        mp_sleep_ns(MP_TIME_MS_TO_NS(2));
+    } while (mp_time_ns() - started < MP_TIME_MS_TO_NS(750));
+
+    MP_ERR(p, "WebHTV FEL fatal: producer handoff failed (result=%d "
+              "pts=%.6f elapsed-ms=%lld staged=%llu); next decode was not "
+              "started with an unreturned published BL frame.\n",
+           result, image->pts, (long long)((mp_time_ns() - started) / 1000000),
+           p->fel_staged);
+    return false;
+}
