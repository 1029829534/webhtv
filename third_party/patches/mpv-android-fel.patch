+    AVBSFContext *bsf;
+    AVPacket *packet;
+};
+
+static inline void mp_android_fel_remove_decoder_config(
+    AVPacketSideData **side_data, int *count)
+{
+    av_packet_side_data_remove(*side_data, count, AV_PKT_DATA_DOVI_CONF);
+    av_packet_side_data_remove(*side_data, count, AV_PKT_DATA_HEVC_CONF);
+}
+
+static inline void mp_android_fel_packet_uninit(
+    struct mp_android_fel_packet_filter *s)
+{
+    av_packet_free(&s->packet);
+    av_bsf_free(&s->bsf);
+}
+
+static inline void mp_android_fel_packet_reset(
+    struct mp_android_fel_packet_filter *s)
+{
+    if (s->bsf)
+        av_bsf_flush(s->bsf);
+    if (s->packet)
+        av_packet_unref(s->packet);
+}
+
+static inline int mp_android_fel_packet_init(
+    struct mp_android_fel_packet_filter *s, AVCodecContext *avctx,
+    bool fel, bool software_el, bool mediacodec, int source_profile)
+{
+    if (!fel || software_el || !mediacodec || source_profile != 7 ||
+        avctx->codec_id != AV_CODEC_ID_HEVC)
+        return 0;
+
+    const AVBitStreamFilter *def = av_bsf_get_by_name("dovi_split");
+    if (!def)
+        return AVERROR_BSF_NOT_FOUND;
+
+    int ret = av_bsf_alloc(def, &s->bsf);
+    if (ret < 0)
+        goto fail;
+    ret = avcodec_parameters_from_context(s->bsf->par_in, avctx);
+    if (ret < 0)
+        goto fail;
+    s->bsf->time_base_in = avctx->pkt_timebase;
+    ret = av_opt_set(s->bsf, "mode", "bl", AV_OPT_SEARCH_CHILDREN);
+    if (ret < 0)
+        goto fail;
+    ret = av_bsf_init(s->bsf);
+    if (ret < 0)
+        goto fail;
+    s->packet = av_packet_alloc();
+    if (!s->packet) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    // The hardware decodes only HEVC pixels. Keep DV7 RPU/NLQ on the software
+    // EL path, whose metadata is inherited by the paired BL before rendering.
+    // Only this private decoder context is changed: the shared track and the
+    // BSF's independently owned original parameters still describe full FEL.
+    mp_android_fel_remove_decoder_config(&avctx->coded_side_data,
+                                         &avctx->nb_coded_side_data);
+    return 0;
+fail:
+    mp_android_fel_packet_uninit(s);
+    return ret;
+}
+
+// 1: ready (also the disabled/drain path); 0: consumed, no BL NAL;
+// <0: invalid input/filter failure. The input is borrowed and never consumed.
+// The returned packet is valid until reset, uninit or the next prepare call.
+static inline int mp_android_fel_packet_prepare(
+    struct mp_android_fel_packet_filter *s, const AVPacket *input,
+    const AVPacket **output)
+{
+    *output = input;
+    if (!s->bsf || !input)
+        return 1;
+    *output = NULL;
+    av_packet_unref(s->packet);
+
+    // mp_set_av_packet borrows both data and side data. The BSF owns its
+    // input, so it must receive an independent ref, never the borrowed shell.
+    int ret = av_packet_ref(s->packet, input);
+    if (ret < 0)
+        goto fail;
+    ret = av_bsf_send_packet(s->bsf, s->packet);
+    if (ret < 0) {
+        // dovi_split is one-in/at-most-one-out and is drained below. A send
+        // EAGAIN here is a broken contract, not a reason to retry forever.
+        if (ret == AVERROR(EAGAIN))
+            ret = AVERROR_BUG;
+        goto fail;
+    }
+    ret = av_bsf_receive_packet(s->bsf, s->packet);
+    if (ret == AVERROR(EAGAIN))
+        return 0;
+    if (ret < 0)
+        goto fail;
+    // A packet can repeat the container configuration after a seek/change.
+    // Do not let it re-enable DV/EL processing in the base-layer decoder.
+    mp_android_fel_remove_decoder_config(&s->packet->side_data,
+                                         &s->packet->side_data_elems);
+    *output = s->packet;
+    return 1;
+fail:
+    mp_android_fel_packet_reset(s);
+    return ret;
+}
